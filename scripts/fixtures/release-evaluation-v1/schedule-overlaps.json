{
  "id": "schedule-overlaps",
  "prompt": "Read input.json. Return result.json with overlapping pairs of appointment IDs. Intervals are half-open [start,end); touching endpoints do not overlap. Compare absolute timestamps, including offsets. Sort each pair and sort the pairs lexically. Do not modify input.json.",
  "input": {
    "appointments": [
      {
        "id": "a",
        "start": "2026-11-06T09:00:00-05:00",
        "end": "2026-11-06T10:00:00-05:00"
      },
      {
        "id": "b",
        "start": "2026-11-06T14:30:00Z",
        "end": "2026-11-06T15:15:00Z"
      },
      {
        "id": "c",
        "start": "2026-11-06T15:15:00Z",
        "end": "2026-11-06T16:00:00Z"
      },
      {
        "id": "d",
        "start": "2026-11-06T16:00:00+01:00",
        "end": "2026-11-06T16:30:00+01:00"
      }
    ]
  },
  "expected": {
    "overlaps": [
      [
        "a",
        "b"
      ],
      [
        "b",
        "d"
      ],
      [
        "c",
        "d"
      ]
    ]
  }
}
