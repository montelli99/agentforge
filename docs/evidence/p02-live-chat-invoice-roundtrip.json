        {
          "checkName": "prepare_task",
          "command": "mkdir -p artifacts && node -e '\nconst fs=require(\"fs\");\nconst invoices=JSON.parse(fs.readFileSync(\"inputs/invoices.json\",\"utf8\"));\nconst best=new Map();\nlet supersededRows=0;\nfor(const inv of invoices){\n  const cur=best.get(inv.id);\n  if(!cur||inv.revision>cur.revision){\n    if(cur) supersededRows++;\n    best.set(inv.id,inv);\n  } else {\n    supersededRows++;\n  }\n}\nlet includedInvoices=0, voidInvoices=0;\nconst groups=new Map();\nfor(const inv of best.values()){\n  if(inv.status===\"void\"){ voidInvoices++; continue; }\n  includedInvoices++;\n  const sign=inv.status===\"refunded\"?-1:1;\n  const key=inv.customer+\"\\u0000\"+inv.currency;\n  let g=groups.get(key);\n  if(!g){ g={customer:inv.customer,currency:inv.currency,netCents:0,count:0}; groups.set(key,g); }\n  g.netCents+=sign*inv.amountCents;\n  g.count++;\n}\nconst rows=[...groups.values()].sort((a,b)=>a.customer<b.customer?-1:a.customer>b.customer?1:a.currency<b.currency?-1:a.currency>b.currency?1:0);\nconst report={rows,includedInvoices,voidInvoices,supersededRows};\nfs.writeFileSync(\"artifacts/report.json\",JSON.stringify(report,null,2)+\"\\n\");\n'",
          "timeoutMs": 15000
        },
        {
          "checkName": "unit_tests",
          "command": "test -s artifacts/report.json",
          "timeoutMs": 5000
        },
        {
          "checkName": "verify_report_content",
          "command": "node -e 'const fs=require(\"fs\");const r=JSON.parse(fs.readFileSync(\"artifacts/report.json\",\"utf8\"));const exp={rows:[{customer:\"Acme\",currency:\"EUR\",netCents:500,count:1},{customer:\"Acme\",currency:\"USD\",netCents:950,count:2},{customer:\"Beta\",currency:\"EUR\",netCents:-75,count:1},{customer:\"Beta\",currency:\"USD\",netCents:300,count:1},{customer:\"Gamma\",currency:\"USD\",netCents:0,count:1}],includedInvoices:6,voidInvoices:1,supersededRows:2};if(JSON.stringify(r)!==JSON.stringify(exp)){console.error(\"MISMATCH\",JSON.stringify(r));process.exit(1);}console.log(\"report verified\");'",
          "timeoutMs": 5000
        }
