{
  "name": "agentforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "start": "node dist/server/start.js",
    "dev": "node --import tsx src/server/start.ts",
    "legacy": "node --import tsx src/server.ts",
    "lab": "node --import tsx src/main.ts",
    "demo": "node --import tsx src/demoClient.ts",
    "benchmark": "node --import tsx src/benchmark-quick.ts",
    "smoke": "node --import tsx src/smoke.ts",
    "export:metrics": "node --import tsx src/export-metrics.ts",
    "docs:collect": "node scripts/consolidate_markdown.cjs",
    "vnext": "node --import tsx src/server/start.ts",
    "cli": "node --import tsx src/cli/bin.ts",
    "build": "tsc -p tsconfig.vnext.json --noEmit false --rootDir src --outDir dist",
    "test": "vitest run src --maxWorkers=1",
    "test:persistence:launcher": "node scripts/persistence-acceptance.mjs",
    "test:package:cli": "node scripts/package-cli-acceptance.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.vnext.json",
    "typecheck:all": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm typecheck:all && pnpm test && pnpm build",
    "test:lab": "node --import tsx src/main.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1"
  }
}
