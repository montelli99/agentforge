{
  "name": "agentforge",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agentforge": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "start": "node dist/server/start.js",
    "dev": "node --import tsx src/server/start.ts",
    "lab": "node --import tsx src/main.ts",
    "demo": "node --import tsx src/demoClient.ts",
    "benchmark": "node --import tsx src/benchmark-quick.ts",
    "smoke": "node --import tsx src/smoke.ts",
    "export:metrics": "node --import tsx src/export-metrics.ts",
    "docs:collect": "node scripts/consolidate_markdown.cjs",
    "preview:website": "node scripts/serve-public-site.mjs",
    "test:website": "node scripts/website-link-acceptance.mjs",
    "vnext": "node --import tsx src/server/start.ts",
    "cli": "node --import tsx src/cli/bin.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.vnext.json --noEmit false --declaration --rootDir src --outDir dist && node scripts/copy-public-assets.mjs && node scripts/validate-built-browser-code.mjs",
    "test": "vitest run src --maxWorkers=1",
    "test:memory:browser": "node scripts/memory-browser-acceptance.mjs",
    "test:connections:browser": "node scripts/connection-browser-acceptance.mjs",
    "test:approval:browser": "node scripts/approval-browser-acceptance.mjs",
    "test:persistence:launcher": "node scripts/persistence-acceptance.mjs",
    "test:persistence:crash": "node scripts/persistence-crash-recovery.mjs",
    "test:execution:crash": "node --import tsx scripts/execution-crash-proof.ts",
    "test:execution:docker-crash": "node --import tsx scripts/docker-execution-crash-proof.ts",
    "test:persistence:concurrency": "node scripts/workspace-concurrency-acceptance.mjs",
    "test:package:cli": "node scripts/package-cli-acceptance.mjs",
    "test:package:surface": "node scripts/public-package-acceptance.mjs",
    "test:repository-privacy": "node --test scripts/public-repository-privacy-acceptance.test.mjs && node scripts/public-repository-privacy-acceptance.mjs",
    "test:public-links": "node --test scripts/public-link-acceptance.test.mjs && node scripts/public-link-acceptance.mjs",
    "test:docker:acceptance": "node scripts/docker-acceptance.mjs",
    "test:approved-docker:e2e": "node --import tsx scripts/approved-docker-e2e.ts",
    "verify:public": "pnpm typecheck:all && pnpm test:product-isolation && pnpm test:repository-privacy && pnpm test:public-links && pnpm build && pnpm test:package:surface && pnpm test:persistence:crash && pnpm test:execution:crash && pnpm test:persistence:concurrency && pnpm test:docker:acceptance && pnpm test:approved-docker:e2e && pnpm test:conversation:e2e && pnpm test:chat:protocol",
    "release:preflight": "pnpm verify:public && pnpm release:audit && pnpm test:registry:preflight && pnpm test:provider:preflight",
    "release:audit": "node scripts/public-release-readiness.mjs",
    "test:registry:preflight": "node scripts/registry-release-preflight.mjs",
    "test:deployment:smoke": "node scripts/deployment-smoke.mjs",
    "test:hosted-ci:evidence": "node scripts/hosted-ci-evidence-acceptance.mjs",
    "test:provider:preflight": "node scripts/provider-acceptance-preflight.mjs",
    "audit:completion": "node scripts/completion-audit-check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.vnext.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:all": "tsc --noEmit -p tsconfig.json && pnpm typecheck:scripts",
    "check": "pnpm typecheck:all && pnpm test:product-isolation && pnpm test && pnpm build && pnpm test:package:surface",
    "test:lab": "node --import tsx src/main.ts",
    "test:product-isolation": "node scripts/product-isolation-acceptance.mjs",
    "test:conversation:e2e": "node --import tsx scripts/conversation-execution-e2e.ts",
    "test:chat:protocol": "node scripts/chat-stream-acceptance.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "playwright": "1.64.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "teleproto": "1.229.0"
  },
  "license": "Apache-2.0",
  "description": "AgentForge is an Apache-2.0 open-source, self-hostable AI workforce control plane with governed execution, scoped memory, and optional provider integrations. Configure and verify external providers separately.",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montelli99/agentforge.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/montelli99/agentforge/issues"
  },
  "homepage": "https://github.com/montelli99/agentforge#readme"
}
