# AgentForge Server Configuration

# Provider API key (optional - server works without it in mock mode)
OPENAI_API_KEY=

# Server port (default: 3000)
AGENTFORGE_PORT=3000

# Enable/disable optimization pipeline (default: true)
AGENTFORGE_OPTIMIZATION=true

# LLM provider: openai, ollama (default: openai)
AGENTFORGE_PROVIDER=openai

# Model to use (default: gpt-4o-mini)
AGENTFORGE_MODEL=gpt-4o-mini

# Include agentforge metadata in OpenAI responses (default: true)
AGENTFORGE_METADATA=true

# Ollama configuration (when AGENTFORGE_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Ollama model name (use the model you want to forward to)
# Examples: llama3.1:8b, qwen2.5:14b, codellama:7b
AGENTFORGE_MODEL=llama3.1:8b
