# AgentForge public runtime configuration
#
# Copy only the settings you need into your deployment environment. Do not put
# credentials in this file, commit a real .env file, or store secrets in a
# workspace snapshot.

# Local server and durable workspace data
AGENTFORGE_PORT=3460
# AGENTFORGE_DATA_DIR=C:\path\outside\the\repository\agentforge-data
# AGENTFORGE_SETTINGS_FILE=C:\path\outside\the\repository\agentforge-settings.json

# Keep the default loopback binding unless a deliberate authenticated deployment
# is being made. A non-loopback host requires AGENTFORGE_API_TOKEN.
# AGENTFORGE_HOST=127.0.0.1
# AGENTFORGE_API_TOKEN=
# AGENTFORGE_AUTH_STRICT=1

# Optional OpenAI-compatible chat route. Both key and model list are required;
# leave all three unset to keep conversations local without model generation.
# AGENTFORGE_CHAT_API_KEY=
# AGENTFORGE_CHAT_MODELS=
# AGENTFORGE_CHAT_PROVIDER=mimo
# MIMO_API_KEY=
# AGENTFORGE_TELEGRAM_CHAT_MODEL=
# AGENTFORGE_CHAT_BASE_URL=https://api.openai.com/v1
# AGENTFORGE_CHAT_MEMORY_NAMESPACE=

# Optional direct AgentForge Telegram connection. The normal BotFather path
# needs only a token file. The advanced user-session route takes precedence
# when all three MTProto values are configured.
# AGENTFORGE_TELEGRAM_BOT_TOKEN_FILE=C:\path\outside\the\repository\telegram-bot-token
# AGENTFORGE_TELEGRAM_BOT_TOKEN=
# AGENTFORGE_TELEGRAM_API_ID=
# AGENTFORGE_TELEGRAM_API_HASH=
# AGENTFORGE_TELEGRAM_SESSION=

# Optional direct Discord Gateway v10 connection.
# AGENTFORGE_DISCORD_BOT_TOKEN_FILE=C:\path\outside\the\repository\discord-bot-token
# AGENTFORGE_DISCORD_BOT_TOKEN=
# AGENTFORGE_DISCORD_GATEWAY_URL=wss://gateway.discord.gg/?v=10&encoding=json

# Optional direct Slack Socket Mode connection.
# AGENTFORGE_SLACK_APP_TOKEN_FILE=C:\path\outside\the\repository\slack-app-token
# AGENTFORGE_SLACK_BOT_TOKEN_FILE=C:\path\outside\the\repository\slack-bot-token
# AGENTFORGE_SLACK_APP_TOKEN=
# AGENTFORGE_SLACK_BOT_TOKEN=

# Optional migration-only relay for an existing OpenClaw or Hermes deployment.
# This is not required for AgentForge's native provider connections.
# AGENTFORGE_GATEWAY_URL=
# AGENTFORGE_GATEWAY_TOKEN=
# AGENTFORGE_GATEWAY_IDENTITY_PATH=

# Optional isolated, approval-gated Docker task execution. It remains off by
# default and needs an explicit absolute repository path.
# AGENTFORGE_EXECUTION_MODE=approved-docker
# AGENTFORGE_EXECUTION_REPO=C:\path\to\isolated\repository
