/* The Command Room constellation is a compact, source-backed view of saved workspace relationships. */
.command-map-card{min-width:0}.command-constellation{position:relative;isolation:isolate;min-height:250px;overflow:hidden;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:radial-gradient(circle at 50% 50%,#c4b5fd12,transparent 33%),radial-gradient(circle at 50% 50%,#7cd4af09,transparent 58%),var(--bg-sidebar)}.command-constellation:before{content:'';position:absolute;z-index:-2;inset:0;opacity:.45;background-image:linear-gradient(#ffffff07 1px,transparent 1px),linear-gradient(90deg,#ffffff07 1px,transparent 1px);background-size:24px 24px;mask-image:radial-gradient(ellipse at center,#000 12%,transparent 78%)}.command-constellation:after{content:'';position:absolute;z-index:-1;inset:25% 23%;border:1px solid #c4b5fd1d;border-radius:50%;box-shadow:0 0 0 22px #c4b5fd05,0 0 0 54px #c4b5fd03}.command-constellation-core{position:absolute;left:50%;top:50%;z-index:2;display:grid;place-items:center;gap:2px;width:92px;height:92px;transform:translate(-50%,-50%);border:1px solid #c4b5fd78;border-radius:23px;background:linear-gradient(145deg,#c4b5fd1e,#18191d);box-shadow:0 0 0 10px #c4b5fd06,0 18px 42px #0004;text-align:center}.command-constellation-core:before{content:'✳';display:grid;place-items:center;width:24px;height:24px;border-radius:8px;background:#c4b5fd22;color:var(--accent);font-size:15px}.command-constellation-core span{color:var(--text-muted);font-size:9px;text-transform:uppercase;letter-spacing:.08em}.command-constellation-core strong{max-width:72px;font-size:11px;line-height:1.25}.command-constellation-link{position:absolute;left:50%;top:50%;z-index:0;width:var(--link-length);height:1px;transform:rotate(var(--link-angle));transform-origin:0 50%;background:linear-gradient(90deg,#c4b5fd75,transparent);opacity:.85}.command-constellation-node{position:absolute;left:var(--node-x);top:var(--node-y);z-index:1;display:grid;justify-items:center;gap:5px;min-width:70px;transform:translate(-50%,-50%);color:var(--text-main);text-align:center;pointer-events:none}.command-constellation-node b{display:grid;place-items:center;width:32px;height:32px;border:3px solid var(--bg-sidebar);border-radius:11px;background:#2b2c33;color:var(--text-main);box-shadow:0 0 0 1px #ffffff21;font-size:11px}.command-constellation-node em{max-width:86px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-muted);font-size:10px;font-style:normal;line-height:1.25}.command-constellation-node.is-active b{background:#c4b5fd24;color:var(--accent);box-shadow:0 0 0 1px #c4b5fd72,0 0 0 6px #c4b5fd08}.command-constellation-node.is-attention b{background:#e9bc7720;color:var(--amber);box-shadow:0 0 0 1px #e9bc7770,0 0 0 6px #e9bc7708}.command-constellation>p{position:absolute;left:16px;bottom:13px;right:16px;margin:0;color:var(--text-muted);font-size:10px;line-height:1.45;text-align:center}.command-constellation-empty .command-constellation-core{width:118px;height:118px}.command-constellation-empty>p{bottom:23px;max-width:230px;left:50%;right:auto;transform:translateX(-50%);width:100%}@media(max-width:600px){.command-constellation{min-height:232px}.command-constellation-node{min-width:58px}.command-constellation-node em{max-width:62px;font-size:9px}.command-constellation-node b{width:29px;height:29px}.command-constellation:after{inset:28% 15%}.command-constellation>p{font-size:9px}}

/* The active workspace mode stays visible and changes only through the explicit mode picker. */
.workspace-experience{display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:8px;align-items:center;min-width:154px;padding:6px 9px 6px 11px;border:1px solid var(--border);border-radius:9px;background:var(--bg-sidebar);color:var(--text-main);font:inherit;text-align:left;cursor:pointer;transition:border-color .18s ease,background .18s ease}.workspace-experience:hover,.workspace-experience:focus-visible{border-color:#c4b5fd66;background:#c4b5fd0b;outline:2px solid var(--accent-dim);outline-offset:2px}.workspace-experience span{grid-column:1;color:var(--text-muted);font-size:8px;font-weight:700;letter-spacing:.1em;line-height:1.2}.workspace-experience strong{grid-column:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;font-weight:600;line-height:1.45}.workspace-experience em{grid-column:2;grid-row:1/3;color:var(--accent);font-size:14px;font-style:normal}.workspace-experience[data-ready=false]{border-style:dashed;color:var(--text-muted)}@media(max-width:920px){.workspace-experience{min-width:132px}.workspace-experience span{font-size:7px}.workspace-experience strong{font-size:10px}}@media(max-width:700px){.workspace-experience{display:none}}

/* The Command Room constellation is a real navigation surface, not decoration. */
button.command-constellation-node{padding:0;border:0;background:transparent;cursor:pointer;pointer-events:auto;font:inherit}
button.command-constellation-node:hover b{transform:translateY(-2px);border-color:var(--accent);box-shadow:0 0 0 1px #c4b5fd90,0 12px 30px #0006}
button.command-constellation-node:hover em{color:var(--text-main)}
button.command-constellation-node:focus-visible{outline:2px solid var(--accent);outline-offset:5px;border-radius:12px}


/* Setup Guide shows the prepared outcome and plan without treating it as completed work. */
.studio-guide-requirements{position:relative;display:grid;gap:10px;margin:3px 14px 12px;padding:13px;border:1px solid #c4b5fd26;border-radius:10px;background:#11121880}.studio-guide-requirements>div{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.studio-guide-requirements>div strong{font-size:12px}.studio-guide-requirements p{margin:0;color:var(--text-muted);font-size:11px;line-height:1.55}.studio-guide-requirements ol{display:grid;gap:5px;margin:0;padding:0;list-style:none}.studio-guide-requirements ol li{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:start;gap:8px;min-height:0;padding:7px;border:0;border-radius:7px;background:#ffffff035}.studio-guide-requirements li div{display:grid;gap:3px;min-width:0}.studio-guide-requirements li strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px}.studio-guide-requirements li small{display:-webkit-box;overflow:hidden;color:var(--text-muted);font-size:10px;line-height:1.35;-webkit-line-clamp:2;-webkit-box-orient:vertical}.studio-guide-requirement-risk{padding:3px 5px;border:1px solid var(--border);border-radius:999px;color:var(--text-muted);font-size:8px;line-height:1;text-transform:uppercase}.studio-guide-requirement-risk[data-risk="critical"]{border-color:#e68b8b6b;color:#f0a0a0}.studio-guide-requirement-risk[data-risk="high"]{border-color:#e9bc776b;color:#e9bc77}.studio-guide-requirements .btn{justify-self:start}</style>
</head>
