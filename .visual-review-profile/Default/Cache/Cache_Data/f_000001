    secondary.appendChild(connectionElement('h2','connection-section-title','Runtime adapters'));renderProviderLibrary(secondary,harness.providers);
  }else{
    const host=compute.hostTelemetry;const stats=connectionElement('div','compute-stat-grid');
    for(const [label,value,detail] of [['Host memory',host?((host.usedMemoryBytes/1073741824).toFixed(1)+' / '+(host.totalMemoryBytes/1073741824).toFixed(1)+' GB'):'Unavailable','Whole host usage; not an agent allocation'],['Logical CPUs',host?String(host.cpuCount):'Unavailable',host?host.platform+' · '+host.architecture:'Host telemetry unavailable'],['Tracked worktrees',String(compute.worktrees.trackedCount),compute.worktrees.runtimeVerified?'Runtime verified':'Record count only'],['Active sandboxes',host?String(host.activeSandboxesCount):'Unavailable','Reported by the local control plane']]){const card=connectionElement('article','compute-stat');card.append(connectionElement('h2','',label),connectionElement('strong','',value),connectionElement('p','',detail));stats.appendChild(card);}primary.appendChild(stats);
    if(host){const memory=connectionElement('div','host-memory-bar');memory.setAttribute('role','meter');memory.setAttribute('aria-label','Host memory used');memory.setAttribute('aria-valuemin','0');memory.setAttribute('aria-valuemax','100');memory.setAttribute('aria-valuenow',String(host.memoryUsagePercent));const used=connectionElement('span','');used.style.width=Math.max(0,Math.min(100,host.memoryUsagePercent))+'%';memory.appendChild(used);primary.appendChild(memory);primary.appendChild(connectionElement('p','connection-section-copy','Host memory sampled when this page loaded · '+host.memoryUsagePercent+'% used.'));}
    secondary.appendChild(connectionElement('h2','connection-section-title','Isolated environments'));const grid=connectionElement('div','provider-grid');for(const [key,name] of [['local','Local sandbox'],['docker','Docker'],['e2b','Cloud sandbox']]){const card=connectionElement('article','provider-card');card.append(connectionElement('span','provider-glyph','□'),connectionElement('h3','',name),connectionElement('span','badge badge-amber',providerReadinessLabel(compute.sandboxes[key])));grid.appendChild(card);}secondary.appendChild(grid);secondary.appendChild(connectionElement('p','connection-section-copy',compute.worktrees.strategy));
  }
  const refresh=connectionElement('button','btn btn-sm btn-secondary connection-refresh','Refresh status');refresh.onclick=()=>showConnectionWorkspace(mode).catch(error=>showToast(error.message));root.querySelector('.connection-tabs').appendChild(refresh);
}
function renderProviderLibrary(root,providers){
  const grid=connectionElement('div','provider-grid');
  for(const provider of providers){const card=connectionElement('article','provider-card');card.append(connectionElement('span','provider-glyph',provider.category==='harness'?'⌘':'✳'),connectionElement('h3','',provider.name),connectionElement('span','badge badge-blue',providerReadinessLabel(provider.readiness)),connectionElement('p','',provider.summary));const details=connectionElement('details','');details.append(connectionElement('summary','','Implementation details'),connectionElement('p','',provider.notes||'No additional notes.'));if(provider.capabilities){for(const capability of provider.capabilities)details.appendChild(connectionElement('p','',capability.capability.replaceAll('_',' ')+': '+providerReadinessLabel(capability.readiness)));}card.appendChild(details);grid.appendChild(card);}root.appendChild(grid);
}

    // Preserve the user's navigation density independently of the active view.
    function setupNavigationGroups(){
      let preferences={};try{preferences=JSON.parse(localStorage.getItem('agentforge-nav-groups')||'{}')||{};}catch{}
      for(const heading of Array.from(document.querySelectorAll('.nav-section'))){
        const name=heading.textContent.trim();const group=document.createElement('details');group.className='nav-group';group.open=preferences[name]!==false;
        const summary=document.createElement('summary');summary.textContent=name;summary.className='nav-group-title';group.append(summary);heading.before(group);
        let next=heading.nextElementSibling;while(next&&!next.classList.contains('nav-section')){const following=next.nextElementSibling;group.append(next);next=following;}heading.remove();
        group.addEventListener('toggle',()=>{preferences[name]=group.open;try{localStorage.setItem('agentforge-nav-groups',JSON.stringify(preferences));}catch{}});
      }
    }
    setupNavigationGroups();
    // Initial Load
    initRealtime();
    async function openInitialWorkspaceView(){
      let initialView='home';
      let hasSavedView=false;
      try{const saved=localStorage.getItem('agentforge-last-view');if(Array.from(document.querySelectorAll('.nav-item')).some(link=>(link.getAttribute('onclick')||'').includes("'"+saved+"'"))){initialView=saved;hasSavedView=true;}}catch{}
      if(!hasSavedView){
        try{const workspaceState=await fetch('/api/workspace').then(response=>response.json());const experience=workspaceState.workspace?.experience;if(experience==='workspace')initialView='messages';else if(experience==='studio')initialView='studio';else if(!experience)initialView='onboarding';}catch{}
      }
      switchView(initialView);
    }
    void openInitialWorkspaceView();
  </script>
